# Copy to .env and adjust. Never commit .env — it is git-ignored.
# All configuration is read from environment variables; there are no secrets in code.

# --- Vehicle simulator (prefix SIM_) ---------------------------------------
SIM_VEHICLE_ID=VH-0001
# can    -> send DBC-encoded frames on a python-can bus (default)
# stdout -> print one JSON snapshot per second (quick demo without a CAN bus)
SIM_OUTPUT=can
# python-can interface: udp_multicast (Docker/Linux), socketcan (real/vcan), virtual (in-process)
SIM_CAN_INTERFACE=udp_multicast
SIM_CAN_CHANNEL=239.74.163.2
SIM_TICK_HZ=10
# Fixed seed -> reproducible drive; leave empty for a random drive
SIM_SEED=
SIM_FAULT_RATE_PER_HOUR=6
SIM_START_LATITUDE=49.0134
SIM_START_LONGITUDE=12.1016
SIM_LOG_LEVEL=INFO
SIM_LOG_JSON=true

# --- Edge gateway (prefix GW_) ----------------------------------------------
GW_VEHICLE_ID=VH-0001
# GW_GATEWAY_ID=gw-VH-0001        # default: gw-<vehicle id>; also the MQTT client id
GW_CAN_INTERFACE=udp_multicast
GW_CAN_CHANNEL=239.74.163.2
GW_PUBLISH_HZ=1
GW_SIGNAL_MAX_AGE_S=3
GW_MQTT_HOST=localhost
GW_MQTT_PORT=1883
# AWS IoT Core: set GW_MQTT_TLS=true, port 8883, and mount the device certificate files.
GW_MQTT_TLS=false
# GW_MQTT_CA_FILE=/certs/AmazonRootCA1.pem
# GW_MQTT_CERT_FILE=/certs/device.pem.crt
# GW_MQTT_KEY_FILE=/certs/private.pem.key
GW_BUFFER_PATH=data/buffer/gateway.sqlite3
GW_BUFFER_MAX_MESSAGES=100000
GW_LOG_LEVEL=INFO
GW_LOG_JSON=true

# --- Telemetry processor: Lambda environment / local ingestor (no prefix) -----
TELEMETRY_TABLE=telemetry
VEHICLES_TABLE=vehicles
# DLQ_URL=https://sqs.eu-central-1.amazonaws.com/<account>/<queue>   # set by CDK in AWS
TTL_DAYS=30
# Local only: point to DynamoDB Local. Leave unset in AWS.
# DYNAMODB_ENDPOINT_URL=http://localhost:8000
